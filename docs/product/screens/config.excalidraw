   "locked": false,
   "type": "text",
   "x": 773.2,
   "y": 594,
   "width": 289.0,
   "height": 21.25,
   "text": "What it cannot do without upstream",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What it cannot do without upstream",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0188",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2046692448,
   "version": 1,
   "versionNonce": 1362426552,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 773.2,
   "y": 624,
   "width": 390.0,
   "height": 150.0,
   "text": "Offering the choices before the write — showing 1 ·\n2 · 3, or conventional | bracketed — needs the\nvocabulary in advance, and today those live as bash\nvariables inside the checker. Copying them into Go\nmakes a second authority that drifts on the next kit\nupdate. Either the screen only refuses, or WritRun\nis asked to expose the schema readably: a report,\nrouted.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Offering the choices before the write — showing 1 ·\n2 · 3, or conventional | bracketed — needs the\nvocabulary in advance, and today those live as bash\nvariables inside the checker. Copying them into Go\nmakes a second authority that drifts on the next kit\nupdate. Either the screen only refuses, or WritRun\nis asked to expose the schema readably: a report,\nrouted.",
   "autoResize": true,
   "lineHeight": 1.25
  },
