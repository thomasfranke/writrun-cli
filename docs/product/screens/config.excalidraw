   "type": "text",
   "x": 773.2,
   "y": 864,
   "width": 382.5,
   "height": 112.5,
   "text": "\"No command overwrites the project's own files\" was\nwritten against the kit clobbering the adopter, not\nagainst the adopter changing their own setting\nthrough the porcelain. A config command needs that\nsentence to say so, or it reads as a violation of\nit.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"No command overwrites the project's own files\" was\nwritten against the kit clobbering the adopter, not\nagainst the adopter changing their own setting\nthrough the porcelain. A config command needs that\nsentence to say so, or it reads as a violation of\nit.",
   "autoResize": true,
   "lineHeight": 1.25
  }
