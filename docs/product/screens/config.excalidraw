   "lineHeight": 1.25
  },
  {
   "id": "el0182",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 716276975,
   "version": 1,
   "versionNonce": 283039323,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 773.2,
   "y": 204,
   "width": 390.0,
   "height": 131.25,
   "text": "check_settings.sh holds HOMES — every documented key\nand the section that owns it — and the vocabularies:\nstage 1|2|3, pr_title_style conventional|bracketed,\nspec_required always|when-warranted, decisions_style\nper-subsystem|chronological, product_layout\nby-concept|by-feature, and the booleans.\nread_setting.sh is the kit's own reader beside it.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "check_settings.sh holds HOMES — every documented key\nand the section that owns it — and the vocabularies:\nstage 1|2|3, pr_title_style conventional|bracketed,\nspec_required always|when-warranted, decisions_style\nper-subsystem|chronological, product_layout\nby-concept|by-feature, and the booleans.\nread_setting.sh is the kit's own reader beside it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0183",
   "angle": 0,
   "strokeColor": "#e9a800",
