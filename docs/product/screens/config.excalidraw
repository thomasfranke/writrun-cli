   "originalText": "Write, then let the kit judge",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0185",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1057753642,
   "version": 1,
   "versionNonce": 2032213171,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 773.2,
   "y": 424,
   "width": 390.0,
   "height": 112.5,
   "text": "The binary need not know a single allowed value: it\nwrites the change, runs check_settings.sh, and keeps\nthe write only on exit 0. A refusal is the script's\nown sentence, and that sentence names the vocabulary\n— \"pr_title_style 'x' is outside its vocabulary:\nconventional bracketed\".",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The binary need not know a single allowed value: it\nwrites the change, runs check_settings.sh, and keeps\nthe write only on exit 0. A refusal is the script's\nown sentence, and that sentence names the vocabulary\n— \"pr_title_style 'x' is outside its vocabulary:\nconventional bracketed\".",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0186",
   "angle": 0,
   "strokeColor": "#e9a800",
   "backgroundColor": "#fff9db",
