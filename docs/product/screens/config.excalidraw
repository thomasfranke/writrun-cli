   "type": "text",
   "x": 0,
   "y": 662.0,
   "width": 672.0,
   "height": 40.0,
   "text": "Every key and its section comes from HOMES in check_settings.sh. Every value is this\nrepository's real settings.json, unedited.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every key and its section comes from HOMES in check_settings.sh. Every value is this\nrepository's real settings.json, unedited.",
   "autoResize": true,
   "lineHeight": 1.25
  },
