   "locked": false,
   "type": "text",
   "x": 1428.7,
   "y": 704,
   "width": 390.0,
   "height": 75.0,
   "text": "The screen only opens inside an adoption, and init\nrefuses there. So the list is every command that can\nrun where you are standing \u2014 a rule that stays\ncheckable as commands are added.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The screen only opens inside an adoption, and init\nrefuses there. So the list is every command that can\nrun where you are standing \u2014 a rule that stays\ncheckable as commands are added.",
   "autoResize": true,
   "lineHeight": 1.25
  },
