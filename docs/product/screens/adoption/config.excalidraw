   "type": "text",
   "x": 773.2,
   "y": 174,
   "width": 340.0,
   "height": 21.25,
   "text": "The kit already carries the whole schema",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The kit already carries the whole schema",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0182",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 716276975,
   "version": 1,
   "versionNonce": 283039323,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 773.2,
   "y": 204,
   "width": 390.0,
   "height": 131.25,
   "text": "check_settings.sh holds HOMES \u2014 every documented key\nand the section that owns it \u2014 and the vocabularies:\nstage 1|2|3, pr_title_style conventional|bracketed,\nspec_required always|when-warranted, decisions_style\nper-subsystem|chronological, product_layout\nby-concept|by-feature, and the booleans.\nread_setting.sh is the kit's own reader beside it.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "check_settings.sh holds HOMES \u2014 every documented key\nand the section that owns it \u2014 and the vocabularies:\nstage 1|2|3, pr_title_style conventional|bracketed,\nspec_required always|when-warranted, decisions_style\nper-subsystem|chronological, product_layout\nby-concept|by-feature, and the booleans.\nread_setting.sh is the kit's own reader beside it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0183",
   "angle": 0,
   "strokeColor": "#e9a800",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1971110187,
   "version": 1,
   "versionNonce": 1777146169,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "rectangle",
   "x": 757.2,
   "y": 380,
   "width": 440,
   "height": 176
  },
  {
   "id": "el0184",
   "angle": 0,
   "strokeColor": "#8a5a00",
   "backgroundColor": "transparent",
