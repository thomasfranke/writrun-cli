   "type": "text",
   "x": 773.2,
   "y": 394,
   "width": 246.5,
   "height": 21.25,
   "text": "Write, then let the kit judge",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Write, then let the kit judge",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0185",
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1057753642,
   "version": 1,
   "versionNonce": 2032213171,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "x": 773.2,
   "y": 424,
   "width": 390.0,
   "height": 112.5,
   "text": "The binary need not know a single allowed value: it\nwrites the change, runs check_settings.sh, and keeps\nthe write only on exit 0. A refusal is the script's\nown sentence, and that sentence names the vocabulary\n\u2014 \"pr_title_style 'x' is outside its vocabulary:\nconventional bracketed\".",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The binary need not know a single allowed value: it\nwrites the change, runs check_settings.sh, and keeps\nthe write only on exit 0. A refusal is the script's\nown sentence, and that sentence names the vocabulary\n\u2014 \"pr_title_style 'x' is outside its vocabulary:\nconventional bracketed\".",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el0186",
   "angle": 0,
   "strokeColor": "#e9a800",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 2117575945,
   "version": 1,
   "versionNonce": 545321645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "rectangle",
   "x": 757.2,
   "y": 580,
   "width": 440,
   "height": 216
  },
  {
   "id": "el0187",
   "angle": 0,
   "strokeColor": "#8a5a00",
